#!/bin/sh
# Run the installed CLI without changing the invoking shell or working directory.
set -e
launcher=$0
while [ -L "$launcher" ]; do
  directory=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd -P)
  target=$(readlink "$launcher")
  case "$target" in
    /*) launcher=$target ;;
    *) launcher=$directory/$target ;;
  esac
done
resources=$(CDPATH= cd -- "$(dirname -- "$launcher")/../../.." && pwd -P)
case $(uname -s) in
  Linux) executable="$resources/../deepseek-harness"; application="$resources/app" ;;
  *) executable="$resources/../MacOS/DeepSeek Harness"; application="$resources/app.asar" ;;
esac
ELECTRON_RUN_AS_NODE=1 exec "$executable" --expose-internals "$application/dsh/node_modules/@deepseek-ai/dsh-desktop-host/lib/cli.js" "$@"
